# Server-side Gemini API credentials. Up to 5 keys for automatic failover.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-3.8-flash
# Local outbound-attempt allowance per server session, including retries (1–100).
GEMINI_MAX_REQUESTS_PER_SESSION=20
# Shared rolling-window cap across all configured keys; Gemini quotas are project-level (1–60).
GEMINI_MAX_REQUESTS_PER_MINUTE=5
# Up to three attempts; retry only 429/503 with provider delay and bounded waits.
GEMINI_MAX_ATTEMPTS=3
# Minimum time between outbound attempts (1,000–60,000 ms).
GEMINI_MIN_INTERVAL_MS=6000
# Leave empty for local exact checks. No automatic paid-provider fallback.
# PACKPROOF_PYTHON=/absolute/path/to/python3
PORT=4173

# Optional named workspace accounts for team assignments and individual sign-off.
# Keep this JSON value in the hosting provider's secret settings; never commit real passwords.
# Use at least one admin and one reviewer. When enabled, this replaces shared Basic Auth credentials.
# PACKPROOF_TEAM_USERS='[{"username":"owner","displayName":"Workspace owner","role":"admin","password":"use-a-unique-12+-character-secret"},{"username":"reviewer1","displayName":"Reviewer One","role":"reviewer","password":"use-a-different-12+-character-secret"}]'
# Require hosted Basic Auth (true/false). Set true after an access password or named accounts are configured.
# PACKPROOF_REQUIRE_AUTH=true
# For a hosted persistent disk, set both paths to its mount and require the mount check at startup.
# PACKPROOF_PERSISTENT_STORAGE_PATH=/var/data
# PACKPROOF_REQUIRE_PERSISTENT_STORAGE=true
